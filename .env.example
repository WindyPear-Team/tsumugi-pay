# 数据库：postgres、mysql 或 sqlite
DATABASE_DRIVER=postgres
# PostgreSQL 连接字符串（MySQL/SQLite 示例见 README）
DATABASE_URL=postgres://tsumugi:tsumugi@localhost:5432/tsumugi_pay?sslmode=disable

# 服务监听与对外回调基址
LISTEN_ADDR=:8080
PUBLIC_BASE_URL=https://pay.example.com

# 生产环境必须使用独立随机值。
APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
# 使用 32 字节随机值后 Base64 编码，例如：openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
BOOTSTRAP_DEMO=false
